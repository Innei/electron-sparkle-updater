new file mode 100644
index 0000000..baeb2de
--- /dev/null
+++ b/Autoupdate/SUDeltaChainApply.h
@@ -0,0 +1,57 @@
+// Shared with the native regression tests. The caller owns the private cache
+// and removes it on failure. The installed host is never an output directory.
+#import "SPUInstallationInputData.h"
+#import "SUBinaryDeltaApply.h"
+#import "SUUpdateValidator.h"
+#import "SPUVerifierInformation.h"
+#import "SUHost.h"
+#import "SUFileManager.h"
+#import "SUStandardVersionComparator.h"
+#import "SPUInstallationType.h"
+#import "SUErrors.h"
+
+static inline BOOL SUApplyDeltaChain(NSArray<SPUInstallationInputData *> *steps, NSArray<NSString *> *archives, SUHost *host, NSString *cache, NSString *destination, void (^progress)(double), NSError **failure)
+{
+    NSError *error = nil;
+    NSString *source = host.bundlePath;
+    NSString *version = host.version;
+    NSString *previousDirectory = nil;
+    BOOL complete = NO;
+    if (steps.count > 0 && steps.count <= 32 && steps.count == archives.count) {
+        for (NSUInteger index = 0; index < steps.count; index++) {
+            @autoreleasepool {
+                SPUInstallationInputData *step = steps[index];
+                NSString *archive = archives[index];
+                BOOL last = index + 1 == steps.count;
+                NSString *directory = last ? destination : [cache stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+                if (step.expectedVersion.length == 0 || step.expectedContentLength == 0 || step.deltaChainPrefix.count != 0 ||
+                    ![step.installationType isEqualToString:SPUInstallationTypeApplication] ||
+                    [SUStandardVersionComparator.defaultComparator compareVersion:version toVersion:step.expectedVersion] != NSOrderedAscending) break;
+                if (![NSFileManager.defaultManager createDirectoryAtPath:directory withIntermediateDirectories:NO attributes:@{NSFilePosixPermissions: @0700} error:&error]) break;
+                SPUVerifierInformation *information = [[SPUVerifierInformation alloc] initWithExpectedVersion:step.expectedVersion expectedContentLength:step.expectedContentLength];
+                NSDictionary *attributes = [NSFileManager.defaultManager attributesOfItemAtPath:archive error:&error];
+                if (attributes == nil || ![attributes[NSFileType] isEqual:NSFileTypeRegular]) break;
+                information.actualContentLength = attributes.fileSize;
+                SUUpdateValidator *validator = [[SUUpdateValidator alloc] initWithDownloadPath:archive signatures:step.signatures host:host verifierInformation:information];
+                if (![validator validateHostHasPublicKeys:&error] || ![validator validateDownloadPathWithFallbackOnCodeSigning:NO error:&error]) break;
+                NSString *output = [directory stringByAppendingPathComponent:host.bundlePath.lastPathComponent];
+                if (!applyBinaryDelta(source, output, archive, NO, ^(double value) {
+                    progress(((double)index + value) / (double)steps.count);
+                }, &error) || ![validator validateWithUpdateDirectory:directory error:&error]) break;
+                NSDictionary *info = [NSDictionary dictionaryWithContentsOfFile:[output stringByAppendingPathComponent:@"Contents/Info.plist"]];
+                NSString *trustedKey = [host.bundle objectForInfoDictionaryKey:@"SUPublicEDKey"];
+                if (trustedKey.length == 0 || ![info[@"SUPublicEDKey"] isEqual:trustedKey] ||
+                    ![info[@"CFBundleIdentifier"] isEqual:host.bundle.bundleIdentifier]) break;
+                if (previousDirectory != nil && ![[[SUFileManager alloc] init] removeItemAtURL:[NSURL fileURLWithPath:previousDirectory] error:&error]) break;
+                previousDirectory = directory;
+                source = output;
+                version = step.expectedVersion;
+                complete = last;
+            }
+        }
+    }
+    if (!complete && failure != NULL) {
+        *failure = error ?: [NSError errorWithDomain:SUSparkleErrorDomain code:SUValidationError userInfo:@{NSLocalizedDescriptionKey: @"Invalid, incompatible, or incomplete delta chain"}];
+    }
+    return complete;
+}
