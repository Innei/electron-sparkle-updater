diff --git a/Sparkle/SUDeltaChain.h b/Sparkle/SUDeltaChain.h
new file mode 100644
index 0000000..e06bfc7
--- /dev/null
+++ b/Sparkle/SUDeltaChain.h
@@ -0,0 +1,48 @@
+// Bounded, forward-only delta paths. Metadata proposes a plan; the installer
+// still authenticates every patch and validates every resulting bundle.
+#import <Sparkle/SUAppcastItem.h>
+#import <Sparkle/SUVersionComparisonProtocol.h>
+
+static inline NSArray<SUAppcastItem *> *SUDeltaChain(NSArray<SUAppcastItem *> *items, SUAppcastItem *target, NSString *installed, NSUInteger history, id<SUVersionComparison> comparator)
+{
+    if (history == 0 || history > 32 || target.contentLength == 0 || target.informationOnlyUpdate ||
+        ![target.installationType isEqualToString:@"application"]) return @[];
+    NSMutableDictionary<NSString *, SUAppcastItem *> *versions = [NSMutableDictionary dictionary];
+    for (SUAppcastItem *item in items) {
+        if (![(item.channel ?: @"") isEqualToString:(target.channel ?: @"")] ||
+            ![(item.osString ?: @"") isEqualToString:(target.osString ?: @"")] ||
+            ![(item.hardwareRequirements ?: @[]) isEqual:(target.hardwareRequirements ?: @[])] ||
+            [comparator compareVersion:item.versionString toVersion:target.versionString] == NSOrderedDescending) continue;
+        // Ambiguous build identities cannot safely participate in a chain.
+        if (versions[item.versionString] != nil) return @[];
+        versions[item.versionString] = item;
+    }
+    NSArray<NSString *> *ordered = [versions.allKeys sortedArrayUsingComparator:^NSComparisonResult(NSString *a, NSString *b) {
+        return [comparator compareVersion:b toVersion:a];
+    }];
+    if (ordered.count > history + 1) ordered = [ordered subarrayWithRange:NSMakeRange(0, history + 1)];
+    if (![ordered containsObject:installed]) return @[];
+    NSMutableDictionary<NSString *, NSNumber *> *costs = [NSMutableDictionary dictionaryWithObject:@0 forKey:installed];
+    NSMutableDictionary<NSString *, NSArray<SUAppcastItem *> *> *paths = [NSMutableDictionary dictionaryWithObject:@[] forKey:installed];
+    for (NSString *version in ordered.reverseObjectEnumerator) {
+        SUAppcastItem *item = versions[version];
+        if (item.informationOnlyUpdate || ![item.installationType isEqualToString:@"application"]) continue;
+        for (NSString *source in item.deltaUpdates) {
+            SUAppcastItem *edge = item.deltaUpdates[source];
+            if (costs[source] == nil || [comparator compareVersion:source toVersion:version] != NSOrderedAscending ||
+                edge.contentLength == 0 || ![@[@"https", @"http"] containsObject:edge.fileURL.scheme.lowercaseString]) continue;
+            NSString *signature = edge.propertiesDictionary[@"enclosure"][@"sparkle:edSignature"];
+            if (![signature isKindOfClass:NSString.class] || [[NSData alloc] initWithBase64EncodedString:signature options:(NSDataBase64DecodingOptions)0].length != 64) continue;
+            uint64_t previous = costs[source].unsignedLongLongValue;
+            if (previous >= target.contentLength || edge.contentLength >= target.contentLength - previous) continue;
+            uint64_t cost = previous + edge.contentLength;
+            NSArray<SUAppcastItem *> *path = [paths[source] arrayByAddingObject:edge];
+            if (costs[version] == nil || cost < costs[version].unsignedLongLongValue ||
+                (cost == costs[version].unsignedLongLongValue && path.count < paths[version].count)) {
+                costs[version] = @(cost);
+                paths[version] = path;
+            }
+        }
+    }
+    return paths[target.versionString] ?: @[];
+}
