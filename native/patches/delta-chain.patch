+@implementation SUDeltaChainTest
+
+- (SUAppcastItem *)item:(NSString *)version edges:(NSDictionary<NSString *, NSNumber *> *)edges
+{
+    NSString *signature = [[NSMutableData dataWithLength:64] base64EncodedStringWithOptions:0];
+    NSMutableArray *deltas = [NSMutableArray array];
+    for (NSString *source in edges) {
+        [deltas addObject:@{@"url": [NSString stringWithFormat:@"https://example.com/%@-%@.delta", source, version], @"sparkle:deltaFrom": source, @"length": edges[source].stringValue, @"sparkle:edSignature": signature}];
+    }
+    return [[SUAppcastItem alloc] initWithDictionary:@{@"sparkle:version": version, @"enclosure": @{@"url": @"https://example.com/full.zip", @"length": @"500", @"sparkle:edSignature": signature}, @"sparkle:deltas": deltas} failureReason:NULL];
+}
+
+- (void)testBoundedCheapestPath
+{
+    SUAppcastItem *one = [self item:@"1" edges:@{}];
+    SUAppcastItem *two = [self item:@"2" edges:@{}];
+    SUAppcastItem *three = [self item:@"3" edges:@{@"1": @20}];
+    SUAppcastItem *four = [self item:@"4" edges:@{@"1": @80}];
+    SUAppcastItem *five = [self item:@"5" edges:@{@"3": @8}];
+    SUAppcastItem *six = [self item:@"6" edges:@{@"4": @10, @"5": @4, @"1": @100}];
+    NSArray *items = @[six, four, two, one, five, three];
+    NSArray *path = SUDeltaChain(items, six, @"1", 6, SUStandardVersionComparator.defaultComparator);
+    XCTAssertEqualObjects([path valueForKey:@"versionString"], (@[@"3", @"5", @"6"]));
+    XCTAssertEqual(SUDeltaChain(items, six, @"1", 4, SUStandardVersionComparator.defaultComparator).count, 0U);
+    XCTAssertEqual(SUDeltaChain(items, six, @"2", 6, SUStandardVersionComparator.defaultComparator).count, 0U);
+    SUAppcastItem *expensive = [self item:@"7" edges:@{@"6": @500}];
+    XCTAssertEqual(SUDeltaChain([items arrayByAddingObject:expensive], expensive, @"1", 6, SUStandardVersionComparator.defaultComparator).count, 0U);
+    SUAppcastItem *equal = [self item:@"7" edges:@{@"1": @32, @"6": @1}];
+    XCTAssertEqual(SUDeltaChain([items arrayByAddingObject:equal], equal, @"1", 6, SUStandardVersionComparator.defaultComparator).count, 1U);
+}
+
+- (void)testRealKansokuChainAndCorruptPatch
+{
+    NSString *fixture = NSProcessInfo.processInfo.environment[@"SPARKLE_CHAIN_FIXTURES"];
+    XCTSkipIf(fixture == nil, @"Set TEST_RUNNER_SPARKLE_CHAIN_FIXTURES to the acceptance manifest");
+    NSError *error = nil;
+    NSDictionary *manifest = [NSJSONSerialization JSONObjectWithData:[NSData dataWithContentsOfFile:fixture] options:0 error:&error];
+    XCTAssertNotNil(manifest);
+    if (manifest == nil) return;
+    SUHost *host = [[SUHost alloc] initWithBundle:[NSBundle bundleWithPath:manifest[@"host"]]];
+    NSMutableArray *steps = [NSMutableArray array];
+    NSMutableArray *archives = [NSMutableArray array];
+    for (NSDictionary *entry in manifest[@"steps"]) {
+        SUSignatures *signatures = [[SUSignatures alloc] initWithEd:entry[@"signature"]
+#if SPARKLE_BUILD_LEGACY_DSA_SUPPORT
+            dsa:nil
+#endif
+        ];
+        [steps addObject:[[SPUInstallationInputData alloc] initWithRelaunchPath:host.bundlePath hostBundlePath:host.bundlePath updateURLBookmarkData:[NSData data] installationType:@"application" signatures:signatures decryptionPassword:nil expectedVersion:entry[@"version"] expectedContentLength:[entry[@"size"] unsignedLongLongValue]]];
+        [archives addObject:entry[@"archive"]];
+    }
+    NSString *cache = [fixture.stringByDeletingLastPathComponent stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    XCTAssertTrue([NSFileManager.defaultManager createDirectoryAtPath:cache withIntermediateDirectories:NO attributes:nil error:&error]);
+    NSString *output = [cache stringByAppendingPathComponent:@"success"];
+    __block double lastProgress = 0;
+    BOOL success = SUApplyDeltaChain(steps, archives, host, cache, output, ^(double progress) { lastProgress = progress; }, &error);
+    XCTAssertTrue(success, @"%@", error);
+    XCTAssertEqualWithAccuracy(lastProgress, 1.0, 0.001);
+    if (success) {
+        NSString *result = [fixture.stringByDeletingLastPathComponent stringByAppendingPathComponent:@"result-path.txt"];
+        XCTAssertTrue([output writeToFile:result atomically:YES encoding:NSUTF8StringEncoding error:&error]);
+    }
+    NSString *corrupt = [cache stringByAppendingPathComponent:@"corrupt.delta"];
+    NSMutableData *bytes = [NSMutableData dataWithContentsOfFile:archives.lastObject];
+    ((unsigned char *)bytes.mutableBytes)[bytes.length - 1] ^= 1;
+    XCTAssertTrue([bytes writeToFile:corrupt atomically:YES]);
+    archives[archives.count - 1] = corrupt;
+    error = nil;
+    XCTAssertFalse(SUApplyDeltaChain(steps, archives, host, cache, [cache stringByAppendingPathComponent:@"failure"], ^(double progress) {}, &error));
+    XCTAssertNotNil(error);
+    XCTAssertEqualObjects([[NSDictionary dictionaryWithContentsOfFile:[host.bundlePath stringByAppendingPathComponent:@"Contents/Info.plist"]] objectForKey:@"CFBundleVersion"], @"0.39.4");
+}
+@end
