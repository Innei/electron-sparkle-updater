+// The installer re-authenticates every patch; this only stops the chain before
+// more bytes are fetched, so an unreadable download (sandboxed XPC container)
+// is not treated as a failure.
+static BOOL SUDeltaDownloadPassesSignatureCheck(SUHost *host, SPUDownloadedUpdate *download)
+{
+    BOOL stale = NO;
+    NSURL *url = [NSURL URLByResolvingBookmarkData:download.downloadBookmarkData options:NSURLBookmarkResolutionWithoutUI relativeToURL:nil bookmarkDataIsStale:&stale error:NULL];
+    NSString *path = url.path;
+    if (path == nil || ![NSFileManager.defaultManager isReadableFileAtPath:path]) return YES;
+    SUAppcastItem *item = download.updateItem;
+    SUSignatures *signatures = item.signatures;
+    if (signatures == nil) return YES;
+    SPUVerifierInformation *information = [[SPUVerifierInformation alloc] initWithExpectedVersion:item.versionString expectedContentLength:item.contentLength];
+    information.actualContentLength = [NSFileManager.defaultManager attributesOfItemAtPath:path error:NULL].fileSize;
+    NSError *error = nil;
+    if ([SUSignatureVerifier validatePath:path withSignatures:signatures withPublicKeys:host.publicKeys verifierInformation:information error:&error]) return YES;
+    SULog(SULogLevelError, @"Delta %@ failed signature verification after download. Falling back to regular update...", item.versionString);
+    SULogError(error);
+    return NO;
+}
