{
  "name": "electron-sparkle-updater",
  "version": "0.4.1",
  "type": "module",
  "license": "MIT",
  "description": "Sparkle-based auto-updates for Electron apps on macOS.",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "default": "./dist/builder.js"
    },
    "./fallback": {
      "types": "./dist/fallback.d.ts",
      "default": "./dist/fallback.js"
    }
  },
  "bin": {
    "electron-sparkle-updater": "./bin/electron-sparkle-updater.js"
  },
  "files": [
    "dist",
    "bin",
    "native/src",
    "native/binding.gyp",
    "README.md",
    "LICENSE",
    "native/patches",
    "native/sparkle-chain.tar.xz",
    "native/scripts/*.sh",
    "native/scripts/*.py"
  ],
  "scripts": {
    "install": "node -e \"\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:history": "python3 -B -m unittest discover -s native/tests -p 'test_*.py'",
    "prepack": "pnpm build && bash native/scripts/package-sparkle.sh"
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "dependencies": {
    "node-addon-api": "^8",
    "node-gyp": "^13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4"
  }
}
